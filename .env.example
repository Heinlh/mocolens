# Azure OpenAI credentials for the LangGraph agent (src/mocolens/agent/).
# From your Azure OpenAI resource's "Keys and Endpoint" page in the Azure Portal.
# Deployment name and API version are fixed in src/mocolens/agent/llm.py.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
