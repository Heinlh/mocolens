# Azure OpenAI credentials for the LangGraph agent (src/mocolens/agent/).
# From your Azure OpenAI resource's "Keys and Endpoint" page in the Azure Portal.
# Deployment (default gpt-5.4-mini) and API version default in src/mocolens/agent/llm.py;
# set AZURE_OPENAI_DEPLOYMENT / AZURE_OPENAI_API_VERSION to override them.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
